DATABASE_URL=sqlite:///./attendance.db
CORS_ORIGINS=*

# SMTP settings for email sign-in codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-address@example.com
SMTP_PASSWORD=your-mail-provider-app-password
SMTP_FROM_EMAIL=your-address@example.com

# Use a long, randomly generated secret that remains the same across restarts/workers
OTP_HASH_SECRET=replace-with-a-random-secret
